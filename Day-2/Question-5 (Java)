import java.util.Scanner;
class sumofdigits
{
    public static void main(String[] args)
    {
        Scanner sc=new Scanner(System.in);
        int rem,sum=0,num;
        System.out.println("Enter the number:");
        num=sc.nextInt();
        while(num!=0){
            rem=num%10;
            sum=sum+rem;
            num=num/10;
        }
        System.out.println("sum of digits is "+sum);
    }
}
